# loglens-sut 튜닝 값의 기준선. ConfigMap loglens-sut-config 가 된다 (Deployment 가 envFrom 으로 읽는다).
# 값을 바꾼 뒤에는 rollout restart 가 필요하다 (README 6절). 따옴표 없이 쓴다 (따옴표도 값에 들어간다).

# 가상 스레드. true 면 SERVER_TOMCAT_THREADS_MAX 는 무시된다.
SPRING_THREADS_VIRTUAL_ENABLED=false

# 플랫폼 스레드 모드의 동시 처리 상한
SERVER_TOMCAT_THREADS_MAX=200

SERVER_TOMCAT_MAX_CONNECTIONS=8192
SERVER_TOMCAT_ACCEPT_COUNT=100

# -1 = keep-alive 연결당 요청 수 무제한 (재연결 비용을 측정에서 뺀다)
SERVER_TOMCAT_MAX_KEEP_ALIVE_REQUESTS=-1

# 힙 = 컨테이너 메모리 limit(deployment.yaml) x 60%. limit 을 바꾸면 힙도 따라간다.
JDK_JAVA_OPTIONS=-XX:+UseG1GC -XX:InitialRAMPercentage=60 -XX:MaxRAMPercentage=60 -XX:+ExitOnOutOfMemoryError
